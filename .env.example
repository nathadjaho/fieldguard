# Nebius Token Factory (https://tokenfactory.nebius.com). Copy to .env and fill in.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model IDs exactly as the Token Factory console lists them. Check before the first run.
# Fast model: proposes fields from a note (every request).
NEMOTRON_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
# Reasoning model: reserved for the referral draft (not wired in the skeleton).
NEMOTRON_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Nemotron 3 thinks before answering; off is faster and cheaper for extraction.
NEMOTRON_THINKING=off
NEMOTRON_MAX_TOKENS=4096
# Demo protection: requests per IP per hour.
RATE_LIMIT_PER_HOUR=30
